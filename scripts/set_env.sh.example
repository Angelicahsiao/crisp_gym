#!/bin/bash
# Template for scripts/set_env.sh -- copy it, do not edit this file in place:
#
#     cp scripts/set_env.sh.example scripts/set_env.sh
#
# scripts/set_env.sh is gitignored on purpose: every machine needs different
# values here. pixi.toml lists it under [activation], so `pixi shell` sources
# it automatically -- and when it is MISSING pixi only prints
#
#     WARN Could not find activation scripts: .../scripts/set_env.sh
#
# and carries on with a partially activated environment. Nothing downstream
# fails loudly, so a fresh clone can run for a long time with CRISP_CONFIG_PATH
# unset before anyone notices. That is the trap this template exists to close.
#
# Source this script; do not execute it directly.

# --- config search order: make crisp_gym's copies win ------------------------
# crisp_py/config and crisp_gym/config are BOTH searched with no env var set
# (crisp_gym/config/path.py:30-33 appends them unconditionally), and crisp_py
# is searched FIRST -- so where a name exists in both, crisp_py's copy is the
# one that loads and crisp_gym's is silently ignored. Nine names currently
# collide; four differ in content, among them cameras/wrist_camera.yaml
# (different topic names AND resolution) and two control YAMLs. find_config()
# warns about each, but only once per name per process.
#
# Entries here are PREPENDED, in the order given, ahead of both built-ins, so
# naming crisp_gym's own config dir flips the winner to crisp_gym. Anything
# already in CRISP_CONFIG_PATH (e.g. from docker-compose) keeps priority over
# it. Derived from this script's location rather than hardcoded, so it follows
# the repo -- same idiom as gen_cyclone_config.sh.
#
# Drop this block if you would rather keep crisp_py's copies winning.
_crisp_gym_cfg="$(cd "$(dirname "${BASH_SOURCE[0]}")/../crisp_gym/config" 2>/dev/null && pwd)"
if [ -n "${_crisp_gym_cfg}" ]; then
    export CRISP_CONFIG_PATH="${CRISP_CONFIG_PATH:+${CRISP_CONFIG_PATH}:}${_crisp_gym_cfg}"
fi
unset _crisp_gym_cfg
# Add your OWN config folders by exporting CRISP_CONFIG_PATH BEFORE this block,
# or by appending to it afterwards; entries are colon-separated container paths,
# each checked with Path(entry).exists(). If NONE of them exist, importing
# crisp_gym raises FileNotFoundError rather than warning, so a typo stops
# everything loudly.

# --- ROS 2 DDS domain --------------------------------------------------------
# DEFAULT-ONLY on purpose (`:=`, the same idiom gen_cyclone_config.sh uses for
# NETWORK_INTERFACE). This file is sourced by PIXI ACTIVATION, which happens
# AFTER the container environment is established -- docker-compose.yml already
# sets ROS_DOMAIN_ID=1 under `environment:`, and a plain `export
# ROS_DOMAIN_ID=100` here would silently override it the moment you enter a
# pixi shell. Nodes on different domains simply cannot see each other, with no
# error to explain it.
#
# So: compose (or whatever already set it) wins; 100 is the fallback for a bare
# shell. Use 100 when working with the crisp_controllers demos. Machines that
# must see each other's topics need the SAME id. Multi-machine setups:
# https://utiasdsl.github.io/crisp_controllers/misc/multi_machine_setup/
: "${ROS_DOMAIN_ID:=100}"
export ROS_DOMAIN_ID

# --- optional: interface CycloneDDS binds to --------------------------------
# Consumed by scripts/gen_cyclone_config.sh, the other activation script. Its
# built-in default (enp0s31f6) is one particular machine's NIC; set yours here.
# `ls /sys/class/net` lists the candidates. gen_cyclone_config.sh falls back to
# 'lo' if the named interface is absent or down.
# Same default-only form, so docker-compose's NETWORK_INTERFACE still wins:
# : "${NETWORK_INTERFACE:=enp0s31f6}"
# export NETWORK_INTERFACE

# --- libstdc++ ordering: pip wheels vs conda-forge ---------------------------
# torch is a PyPI wheel. manylinux wheels carry no RPATH into the pixi env, so
# the loader falls through to /etc/ld.so.cache and maps the SYSTEM
# libstdc++.so.6 -- 6.0.30 on Ubuntu 22.04, which tops out at CXXABI_1.3.13.
# torch is also the FIRST thing lerobot's policy factory imports, and only one
# libstdc++.so.6 SONAME can be mapped per process, so every later import
# inherits that old copy. cv2 4.13 needs CXXABI_1.3.15 and dies:
#
#     ImportError: /usr/lib/x86_64-linux-gnu/libstdc++.so.6: version
#     `CXXABI_1.3.15' not found (required by .../cv2.cpython-312-*.so)
#
# reached via lerobot/policies/groot/processor_groot.py. What makes this
# confusing is that `python -c "import cv2"` on its own SUCCEEDS: with nothing
# loaded yet, cv2 finds the env's 6.0.35 itself. The failure is purely about
# who loads first, so there is no in-Python workaround -- it has to be set
# before the process starts.
#
# Preloading the env's copy fixes it. libstdc++ symbol versions are additive,
# so 6.0.35 satisfies every binary built against 6.0.30, including system ones
# that inherit this via child processes. Preferred over putting
# $CONDA_PREFIX/lib on LD_LIBRARY_PATH, which would override the RUNPATH of
# every conda-forge library in the env and leak into system binaries too --
# a whole-env change for a one-library problem.
#
# The symlink is deliberate: a pixi update that bumps libstdc++ keeps working,
# where a pinned .6.0.35 would silently stop matching. Guarded so a shell
# without CONDA_PREFIX does not make ld.so print "cannot be preloaded" in
# front of every command you run.
if [ -n "${CONDA_PREFIX}" ] && [ -e "${CONDA_PREFIX}/lib/libstdc++.so.6" ]; then
    export LD_PRELOAD="${CONDA_PREFIX}/lib/libstdc++.so.6${LD_PRELOAD:+:${LD_PRELOAD}}"
fi
